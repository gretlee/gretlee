from datetime import datetime, timedelta

forecast_days = 7
sample_locations = [
    {'lat': 33.6844, 'lon': 73.0479, 'name': 'Region 1'},
    {'lat': 31.5204, 'lon': 74.3587, 'name': 'Region 2'},
    {'lat': 24.8607, 'lon': 67.0011, 'name': 'Region 3'},
]

forecasts = []

for day in range(forecast_days):
    target_date = datetime.now() + timedelta(days=day)
    day_total = 0
    day_water = 0
    day_food = 0
    day_tent = 0
    
    for location in sample_locations:
        for need in ['water', 'food', 'tent']:
            for urgency in ['high', 'medium', 'low']:
                features = [
                    location['lat'],
                    location['lon'],
                    target_date.weekday(),
                    target_date.day,
                    target_date.month,
                    le_need.transform([need])[0],
                    le_urgency.transform([urgency])[0]
                ]
                
                features_scaled = scaler.transform([features])
                predicted = max(0, int(model.predict(features_scaled)[0]))
                
                day_total += predicted
                if need == 'water':
                    day_water += predicted
                elif need == 'food':
                    day_food += predicted
                elif need == 'tent':
                    day_tent += predicted
    
    forecasts.append({
        'date': target_date.strftime('%Y-%m-%d'),
        'day_name': target_date.strftime('%A'),
        'total': day_total,
        'water': day_water,
        'food': day_food,
        'tent': day_tent
    })

forecast_df = pd.DataFrame(forecasts)
print("7-Day Demand Forecast:")
print(forecast_df)## 6. Visualize 7-Day Demand Forecast# Create interactive map
